<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Arstraea.KoreanPatch</AssemblyName>
    <RootNamespace>Arstraea.KoreanPatch</RootNamespace>
    <Version>1.0.0</Version>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <Import Project="Local.props" Condition="Exists('Local.props')" />
  <PropertyGroup>
    <CecilPath Condition="'$(CecilPath)' == ''">$([System.IO.Path]::GetDirectoryName('$(HarmonyPath)'))/Mono.Cecil.dll</CecilPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source/**/*.cs" />
    <Reference Include="VRage"><HintPath>$(GameBinPath)/VRage.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Math"><HintPath>$(GameBinPath)/VRage.Math.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Library"><HintPath>$(GameBinPath)/VRage.Library.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Game"><HintPath>$(GameBinPath)/VRage.Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Render"><HintPath>$(GameBinPath)/VRage.Render.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Audio"><HintPath>$(GameBinPath)/VRage.Audio.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sandbox.Graphics"><HintPath>$(GameBinPath)/Sandbox.Graphics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sandbox.Game"><HintPath>$(GameBinPath)/Sandbox.Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(CecilPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="SharpDX"><HintPath>$(GameBinPath)/SharpDX.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SharpDX.Desktop"><HintPath>$(GameBinPath)/SharpDX.Desktop.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckLocalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameBinPath)/VRage.dll')" Text="Set GameBinPath to the installed game's Bin64 directory (or use Dev/Build.ps1)." />
    <Error Condition="!Exists('$(HarmonyPath)')" Text="Set HarmonyPath to the selected Pulsar runtime's 0Harmony.dll (or use Dev/Build.ps1)." />
    <Error Condition="!Exists('$(CecilPath)')" Text="Set CecilPath to the selected Pulsar runtime's Mono.Cecil.dll." />
  </Target>
</Project>
